# ローカル(deno task dev)用の環境変数。コピーして .env を作る:
#   cp .env.example .env
# .env は .gitignore 済み（コミットしないこと）。本番は Deno Deploy のダッシュボードで設定する。

SLACK_WEBHOOK_URL=

# 気象庁の府県予報区コード（必須）。名称は area-codes.ts から自動解決される。
# 例: 130000, 270000, 230000, 400000（一覧は area-codes.ts を参照）
AREA_CODE=

# timeSeries[0].areas の何番目を使うか（任意。未設定なら 0）
# FORECAST_AREA_INDEX=0
